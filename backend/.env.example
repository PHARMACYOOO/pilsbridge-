DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pilbridge?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# How long sessions last: patients and riders (JWT_TTL), and pharmacy staff and admins (STAFF_SESSION_TTL).
JWT_TTL="7d"
STAFF_SESSION_TTL="12h"
# Roles that must confirm sign-in with an authenticator app. Production requires at least PLATFORM_ADMIN and PHARMACIST.
MFA_REQUIRED_ROLES="PLATFORM_ADMIN,PHARMACIST"
# Encrypts authenticator secrets at rest. Required in production (at least 32 characters); generate like JWT_SECRET.
MFA_ENCRYPTION_KEY=""
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# The website's public address, used in links inside text messages (e.g. https://pilbridge.ng/rider). Defaults to the first CORS_ORIGIN.
APP_URL=""
# How often to check deliveries (ms): text customers whose order is late, and text admins about late orders and jobs no rider has taken. 0 turns it off.
LATE_CHECK_MS=60000
# How often to check pharmacy licences (ms): suspend expired ones and text 60/30/7-day reminders. 0 turns it off.
COMPLIANCE_CHECK_MS=3600000
# "development" on your own machine. Anything else (including leaving it unset) is treated as production:
# development shortcuts are refused and production settings (Termii, Flutterwave, MFA key) are required.
NODE_ENV=development
# Development only (needs NODE_ENV=development). Returns OTP codes in API responses instead of sending SMS.
OTP_DEV_ECHO=false
# SMS provider: Termii (required in production; leave the key empty in development).
TERMII_API_KEY=""
# Your account's base URL, from the Termii dashboard.
TERMII_BASE_URL="https://api.ng.termii.com"
# Must be registered and approved on Termii (3–11 letters or digits).
TERMII_SENDER_ID="Pilbridge"
# "dnd" reaches numbers on Do-Not-Disturb (ask Termii support to activate it); "generic" doesn't, and skips MTN at night.
TERMII_CHANNEL="dnd"
UPLOAD_DIR="./uploads"

# Payments: Flutterwave (required in production). Keys from Flutterwave dashboard → Settings → API keys;
# use the test keys until you go live. Without them, development shows a demo payment instead.
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
# Webhook: set the URL https://<api-domain>/v1/payments/flutterwave/webhook and a secret hash on the dashboard
# (Settings → Webhooks), and put the same secret hash here.
FLW_SECRET_HASH=""

# Courier APIs. Chowdeck Relay: secret key from dashboard.chowdeck.com → Settings → Developers.
# Confirm the base URL with Chowdeck at onboarding (their docs show both api.chowdeck.com and api.relay.chowdeck.com).
CHOWDECK_API_KEY=""
CHOWDECK_BASE_URL="https://api.chowdeck.com"
# Webhook secret from the same page; register https://<api-domain>/v1/webhooks/chowdeck there.
CHOWDECK_WEBHOOK_SECRET=""
# Relay's item_type for sealed pharmacy parcels — ask Chowdeck which value to use.
CHOWDECK_ITEM_TYPE="others"
# Book a connected courier automatically when a ready order has no rider (true/false).
AUTO_BOOK_COURIERS=false
# Delivery price at checkout: "standard" (flat fee) or "courier" (live courier quote + margin, when the customer pins their location).
DELIVERY_PRICING=standard
# Courier pricing, in kobo: margin added to the courier's quote, and the min/max customer delivery fee.
DELIVERY_MARGIN_KOBO=30000
DELIVERY_MIN_KOBO=100000
DELIVERY_MAX_KOBO=1000000

# Social sign-in: the same IDs the website uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID / NEXT_PUBLIC_APPLE_CLIENT_ID).
# ID tokens are only accepted when their audience matches these. For Apple, this is the Services ID.
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Set when running behind a load balancer/reverse proxy (e.g. 1 = trust one hop), so rate limits see real client IPs.
TRUST_PROXY=""
