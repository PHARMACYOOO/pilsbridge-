# Where the Pilbridge API (backend/) is running.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Enables live prescription reading on /scan. Without it, the scan page returns a sample reading.
ANTHROPIC_API_KEY=

# Google / Apple sign-in, in the page (no redirect). Without these, the buttons open a development-only demo.
# The API checks every sign-in: set GOOGLE_CLIENT_ID / APPLE_CLIENT_ID in backend/.env to the same IDs.

# Google: create an OAuth client ("Web application") at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:3000 and your live domain. No redirect URI is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple: a Services ID with "Sign in with Apple" enabled; register your domain and this return URL with it.
# Apple requires HTTPS, so test it on a deployed URL.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://your-domain.example/signin
